# Serveur
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Base de données
DATABASE_URL="postgresql://worm:wormpassword@localhost:5432/worm_error_404?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-secret-in-production"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Plan gratuit
FREE_MESSAGE_LIMIT=15

# IA (à renseigner plus tard)
AI_API_KEY=""
AI_API_URL=""
AI_SYSTEM_PROMPT=""

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
